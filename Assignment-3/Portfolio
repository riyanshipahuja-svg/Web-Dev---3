<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="pagal.css">
</head>
<body>

    <!-- ================= HEADER ================= -->
    <header class="header">
        <div class="logo">MyPortfolio</div>
        <nav class="nav">
            <a href="#hero">Home</a>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>


    <!-- ================= HERO SECTION ================= -->
    <section id="hero" class="hero">
        <div class="hero-text fade-in">
            <h1>Hello, I'm <span class="highlight">Riyanshi</span></h1>
            <h2 class="animated-role">B.Tech CSE (AI/ML)</h2>
            <p>I explore artificial intelligence, machine learning, and modern computing technologies.</p>
            <button class="btn">View My Work</button>
        </div>

        <div class="hero-img fade-in">
            <img src="Pagal.jpg" alt="Profile Picture">
        </div>
    </section>


    <!-- ================= ABOUT ================= -->
    <section id="about" class="about">
        <h2 class="section-title">About Me</h2>
        <p>
            I am a B.Tech Computer Science Engineering (AI & ML) student passionate about artificial intelligence, 
            machine learning, and data-driven applications. I am also interested in embedded systems and hands-on 
            technology projects like Arduino. I enjoy learning, experimenting, and building smart and innovative solutions.
        </p>
    </section>


    <!-- ================= SKILLS (GRID) ================= -->
    <section id="skills" class="skills">
        <h2 class="section-title">Skills</h2>

        <div class="skills-grid">
            <div class="skill-card">Python</div>
            <div class="skill-card">Machine Learning</div>
            <div class="skill-card">Data Analysis</div>
            <div class="skill-card">Arduino</div>
            <div class="skill-card">HTML</div>
            <div class="skill-card">CSS</div>
        </div>
    </section>


    <!-- ================= PROJECTS (GRID) ================= -->
    <section id="projects" class="projects">
        <h2 class="section-title">Projects</h2>

        <div class="projects-grid">
            <div class="project-card">
                <h3>AI/ML Learning Projects</h3>
                <p>Exploring machine learning algorithms, data preprocessing, prediction models, and visualization tasks.</p>
            </div>

            <div class="project-card">
                <h3>Arduino Projects</h3>
                <p>Building embedded systems using sensors, automation modules, and robotics components.</p>
            </div>

            <div class="project-card">
                <h3>Web Dev Mini Projects</h3>
                <p>Responsive websites and UI/UX focused web applications using HTML, CSS, and JavaScript.</p>
            </div>
        </div>
    </section>


    <!-- ================= CONTACT ================= -->
    <section id="contact" class="contact">
        <h2 class="section-title">Contact Me</h2>

        <form class="contact-form">
            <input type="text" placeholder="Name" required>
            <input type="email" placeholder="Email" required>
            <textarea placeholder="Message" rows="5" required></textarea>
            <button class="btn">Send Message</button>
        </form>
    </section>


    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <p>© 2025 Riyanshi — All Rights Reserved</p>
    </footer>

</body>
</html>
