/* ================== GLOBAL STYLES ================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #f9f9f9;
    color: #333;
    line-height: 1.6;
}

/* Color Theme */
:root {
    --primary: #0077ff;
    --secondary: #00c2ff;
    --dark: #222;
    --light: #fff;
}

/* Reusable classes */
.section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 2rem;
}


/* ================== HEADER (FLEXBOX) ================== */

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    background: var(--light);
    position: sticky;
    top: 0;
    z-index: 10;
}

.nav a {
    margin-left: 1.5rem;
    text-decoration: none;
    color: var(--dark);
    font-weight: 600;
    transition: color .3s;
}

.nav a:hover {
    color: var(--primary);
}

/* ================== HERO (FLEXBOX) ================== */

.hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5rem 5%;
    min-height: 90vh;
    flex-wrap: wrap;
}

.hero-text {
    max-width: 45%;
}

.hero-img img {
    width: 100%;
    max-width: 350px;
    border-radius: 1rem;
}

.highlight {
    color: var(--primary);
}

/* Button with transform + transition */
.btn {
    padding: 0.8rem 2rem;
    background: var(--primary);
    border: none;
    color: var(--light);
    font-size: 1rem;
    border-radius: .5rem;
    margin-top: 1rem;
    cursor: pointer;
    transition: background .3s, transform .3s;
}

.btn:hover {
    background: var(--secondary);
    transform: scale(1.05);
}

/* ================== ABOUT ================== */

.about {
    padding: 4rem 10%;
    text-align: center;
}

/* ================== SKILLS (GRID) ================== */

.skills {
    padding: 4rem 10%;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
}

.skill-card {
    background: var(--light);
    padding: 1.5rem;
    text-align: center;
    font-weight: bold;
    border-radius: 0.5rem;
    transition: transform .3s;
}

.skill-card:hover {
    transform: translateY(-5px);
}

/* ================== PROJECTS (GRID) ================== */

.projects {
    padding: 4rem 10%;
}

.projects-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
}

.project-card {
    background: var(--light);
    padding: 1.5rem;
    border-radius: .7rem;
    box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    transition: transform .3s;
}

.project-card:hover {
    transform: scale(1.03);
}

/* ================== CONTACT ================== */

.contact {
    padding: 4rem 10%;
}

.contact-form {
    max-width: 500px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.contact-form input, 
.contact-form textarea {
    padding: 1rem;
    border: 2px solid #ccc;
    border-radius: .5rem;
    font-size: 1rem;
}

/* ================== FOOTER ================== */

.footer {
    background: var(--dark);
    color: var(--light);
    text-align: center;
    padding: 1.5rem 0;
}

/* ================== ANIMATIONS ================== */

/* Color-changing animation */
.animated-role {
    animation: colorChange 3s infinite;
}

@keyframes colorChange {
    0%   { color: var(--primary); }
    50%  { color: var(--secondary); }
    100% { color: var(--primary); }
}

/* Fade-in effect */
.fade-in {
    animation: fadeIn 1.5s ease-in-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ================== RESPONSIVE MEDIA QUERIES ================== */

/* Tablet & Mobile */
@media (max-width: 768px) {
    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero-text {
        max-width: 100%;
        margin-bottom: 2rem;
    }
}
